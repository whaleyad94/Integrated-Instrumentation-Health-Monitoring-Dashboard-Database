		<comment> <![CDATA[Primary key. Auto-incrementing integer identifier for each instrument status]]> </comment>
	</column>
	<column name="status_code" not-null="true">
		<type name="varchar" length="10"/>
		<comment> <![CDATA[Short code for the instrument status (e.g., ACT for Active, OOS for Out of Service, DEG for Degraded, FAIL for Failed)]]> </comment>
	</column>
	<column name="status_name" not-null="true">
		<type name="varchar" length="30"/>
		<comment> <![CDATA[Full name of the instrument status (e.g., Active, Out of Service, Degraded, Failed, Decommissioned)]]> </comment>
	</column>
	<column name="is_readings_valid" default-value="TRUE">
		<type name="boolean" length="0"/>
		<comment> <![CDATA[Whether readings from instruments in this status should be considered valid for monitoring and trending purposes.]]> </comment>
	</column>
	<column name="description">
