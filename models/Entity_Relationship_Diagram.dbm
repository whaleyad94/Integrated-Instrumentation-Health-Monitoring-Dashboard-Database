<table name="pca_analysis_sensors" layers="0" collapse-mode="2" max-obj-count="8" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="2200" y="0"/>
	<column name="pca_sensor_id" not-null="true"
	 identity-type="ALWAYS">
		<type name="integer" length="0"/>
		<comment> <![CDATA[Primary key. Auto-incrementing integer identifier for each PCA analysis-sensor association.]]> </comment>
	</column>
	<column name="sensor_index" not-null="true">
		<type name="integer" length="0"/>
		<comment> <![CDATA[Position of this sensor in the PCA model's feature vector (0-indexed). Determines which column in the loading matrix corresponds to this sensor.]]> </comment>
	</column>
	<column name="contribution_to_t_squared">
		<type name="numeric" length="0"/>
		<comment> <![CDATA[This sensor's contribution to the T-squared statistic in this analysis. Higher values indicate greater influence on the detected variation. Used for fault isolation.]]> </comment>
	</column>
	<column name="contribution_to_q_residual">
		<type name="numeric" length="0"/>
		<comment> <![CDATA[This sensor's contribution to the Q-residual statistic in this analysis. A high Q contribution indicates this sensor has broken from its expected correlation with the group.]]> </comment>
	</column>
	<column name="is_faulted" not-null="true" default-value="FALSE">
		<type name="boolean" length="0"/>
		<comment> <![CDATA[Whether this specific sensor was identified as the source of a fault in this analysis. Only one sensor per analysis is typically flagged unless a common-cause event is detected.]]> </comment>
	</column>
	<constraint name="pca_analysis_sensors_pk" type="pk-constr" table="public.pca_analysis_sensors">
		<columns names="pca_sensor_id" ref-type="src-columns"/>
	</constraint>
</table>

<relationship name="pca_analyses_has_many_pca_analysis_sensors" type="rel1n" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 fk-idx-pattern="{st}_idx"
	 custom-color="#6b8e23"
	 src-table="public.pca_analyses"
	 dst-table="public.pca_analysis_sensors"
	 src-required="false" dst-required="false"/>

<relationship name="instruments_has_many_pca_analysis_sensors" type="rel1n" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 fk-idx-pattern="{st}_idx"
	 custom-color="#b22222"
	 src-table="public.instruments"
	 dst-table="public.pca_analysis_sensors"
	 src-required="false" dst-required="false"/>

<constraint name="fk_locations_parent" type="fk-constr" comparison-type="MATCH SIMPLE"
	 upd-action="NO ACTION" del-action="SET NULL" ref-table="public.locations" table="public.locations">
	<columns names="parent_location_id" ref-type="src-columns"/>
	<columns names="location_id" ref-type="dst-columns"/>
</constraint>

<relationship name="rel_locations_locations" type="relfk" layers="0"
	 src-table="public.locations"
	 dst-table="public.locations" reference-fk="fk_locations_parent"
	 src-required="false" dst-required="false">
