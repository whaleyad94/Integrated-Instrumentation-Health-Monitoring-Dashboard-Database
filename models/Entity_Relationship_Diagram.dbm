<dbmodel pgmodeler-ver="1.2.3" use-changelog="false" max-obj-count="8"
	 gen-disabled-objs-code="false" show-sys-schemas-rects="true"
	 last-position="131,81" last-zoom="1" scene-rect="0,-20,1802.44,1172.72"
	 default-schema="public" default-owner="postgres"
