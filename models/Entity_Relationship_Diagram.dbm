	</column>
	<column name="system_code" not-null="true">
		<type name="varchar" length="10"/>
		<comment> <![CDATA[Standard system identifier code (e.g., RCS, CVCS, MSS, ECCS). Used in plant documentation, P&IDs, and work orders.]]> </comment>
	</column>
	<column name="system_name" not-null="true">
		<type name="varchar" length="100"/>
