</table>

<table name="instruments" layers="0" collapse-mode="2" max-obj-count="32" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="618" y="151"/>
	<column name="instrument_id" not-null="true"
	 identity-type="ALWAYS">
		<type name="integer" length="0"/>
		<comment> <![CDATA[Primary key. Auto-incrementing integer identifier for each individual instrument]]> </comment>
	</column>
	<column name="tag_number" not-null="true">
		<type name="varchar" length="20"/>
		<comment> <![CDATA[Plant instrument tag number per ISA-5.1 conventions (e.g., TE-0412A). The unique plant-wide identifier used on P&IDs, work orders, and Technical Specifications.]]> </comment>
	</column>
	<column name="manufacturer">
		<type name="varchar" length="100"/>
		<comment> <![CDATA[Instrument manufacturer. Important for tracking vendor-specific issues, 10CFR21 defect notifications, and procurement.]]> </comment>
	</column>
	<column name="model_number">
		<type name="varchar" length="50"/>
		<comment> <![CDATA[Manufacturer model number. Determines exact technical specifications, spare parts compatibility, and applicable maintenance procedures.]]> </comment>
	</column>
	<column name="serial_number">
		<type name="varchar" length="50"/>
		<comment> <![CDATA[Unique manufacturer serial number for this specific device. Required for traceability — every calibration record, maintenance action, and quality record references the serial number.]]> </comment>
	</column>
	<column name="range_min">
		<type name="numeric" length="0"/>
		<comment> <![CDATA[Lower bound of this instrument's calibrated range. This is the actual configured range, not the general capability of the instrument type.]]> </comment>
	</column>
	<column name="range_max">
		<type name="numeric" length="0"/>
		<comment> <![CDATA[Upper bound of this instrument's calibrated range. This is the actual configured range, not the general capability of the instrument type]]> </comment>
	</column>
	<column name="range_unit">
		<type name="varchar" length="20"/>
		<comment> <![CDATA[Engineering unit for this instrument's calibrated range (e.g., °C, MPa, % power).]]> </comment>
	</column>
	<column name="setpoint_high">
		<type name="numeric" length="0"/>
		<comment> <![CDATA[High alarm or trip setpoint value. Null if this instrument does not drive alarms or trips]]> </comment>
	</column>
	<column name="setpoint_low">
		<type name="numeric" length="0"/>
		<comment> <![CDATA[Low alarm or trip setpoint value. Null if this instrument does not drive alarms or trips.]]> </comment>
	</column>
	<column name="accuracy">
		<type name="varchar" length="50"/>
		<comment> <![CDATA[Actual accuracy specification for this specific instrument as installed and calibrated. May differ from the instrument type's typical accuracy due to range, environment, and age.]]> </comment>
	</column>
	<column name="loop_number">
		<type name="varchar" length="20"/>
		<comment> <![CDATA[Instrument loop this device belongs to. Multiple instruments often share a loop — a sensor, transmitter, indicator, and controller may all be part of the same loop]]> </comment>
	</column>
	<column name="redundancy_group">
		<type name="varchar" length="20"/>
		<comment> <![CDATA[Redundancy division or train this instrument belongs to (e.g., Division I, Train A, Channel III). Critical for Technical Specification operability and allowed outage time tracking]]> </comment>
	</column>
	<column name="tech_spec_reference">
		<type name="varchar" length="50"/>
		<comment> <![CDATA[Reference to the applicable Technical Specification section if any. Directly links the instrument to its regulatory surveillance and operability requirements]]> </comment>
	</column>
	<column name="installation_date">
		<type name="date" length="0"/>
		<comment> <![CDATA[Date the instrument was first installed in the plant.]]> </comment>
	</column>
	<column name="last_calibration_date">
		<type name="date" length="0"/>
		<comment> <![CDATA[Date of the most recent calibration. Used with calibration_interval_months to calculate next due date and flag overdue instruments.]]> </comment>
	</column>
	<column name="calibration_interval_months">
		<type name="integer" length="0"/>
		<comment> <![CDATA[Required calibration frequency in months. Typically 18 or 24 months for safety-related instruments, aligned with refueling outages.]]> </comment>
	</column>
	<column name="is_tech_spec" not-null="true" default-value="FALSE">
		<type name="boolean" length="0"/>
		<comment> <![CDATA[Whether this instrument is referenced in the plant Technical Specifications. Tech Spec instruments have the most stringent surveillance requirements.]]> </comment>
	</column>
	<column name="is_eq_required" not-null="true" default-value="FALSE">
		<type name="boolean" length="0"/>
		<comment> <![CDATA[Whether this instrument must be environmentally qualified per 10CFR50.49 to function under design basis accident conditions.]]> </comment>
	</column>
	<column name="description">
		<type name="text" length="0"/>
		<comment> <![CDATA[Additional notes specific to this instrument including special installation conditions, known issues, or compensatory measures when out of service.]]> </comment>
	</column>
	<column name="created_at" not-null="true" default-value="CURRENT_TIMESTAMP">
		<type name="timestamp" length="0"/>
		<comment> <![CDATA[Timestamp of when this record was created in the database.]]> </comment>
	</column>
	<column name="updated_at" not-null="true" default-value="CURRENT_TIMESTAMP">
		<type name="timestamp" length="0"/>
		<comment> <![CDATA[Timestamp of the last update to this record. Should be updated automatically on any modification.]]> </comment>
	</column>
	<constraint name="instruments_pk" type="pk-constr" table="public.instruments">
		<columns names="instrument_id" ref-type="src-columns"/>
	</constraint>
	<constraint name="uq_instruments_tag_number" type="uq-constr" table="public.instruments">
		<columns names="tag_number" ref-type="src-columns"/>
	</constraint>
</table>

<relationship name="instrument_types_has_many_instruments" type="rel1n" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 fk-idx-pattern="{st}_idx"
	 custom-color="#db1653"
	 src-table="public.instrument_types"
