<table name="alerts" layers="0" collapse-mode="2" max-obj-count="16" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="1560" y="-284.444"/>
	<column name="alert_id" not-null="true"
	 identity-type="ALWAYS">
		<type name="bigint" length="0"/>
		<comment> <![CDATA[Primary key. Auto-incrementing bigint identifier for each alert event.]]> </comment>
	</column>
	<column name="alert_type" not-null="true">
		<type name="varchar" length="30"/>
		<comment> <![CDATA[Classification of the alert.]]> </comment>
	</column>
	<column name="alert_severity" not-null="true">
		<type name="varchar" length="15"/>
		<comment> <![CDATA[Severity level of the alert (e.g., INFO, WARNING, ALARM, CRITICAL). Drives dashboard prioitization and notification routing. ]]> </comment>
	</column>
	<column name="alert_message" not-null="true">
		<type name="text" length="0"/>
		<comment> <![CDATA[Human-readable description of the alert condition (e.g., 'RCS pressure exceeded high alarm setpoint of 15.9 MPa'). ]]> </comment>
	</column>
	<column name="trigger_value">
		<type name="numeric" length="0"/>
		<comment> <![CDATA[The instrument reading value that triggered the alert. Null for non-measurement-based alerts like calibration reminders. ]]> </comment>
	</column>
	<column name="trigger_threshold">
		<type name="numeric" length="0"/>
		<comment> <![CDATA[The setpoint or threshold value that was exceeded to trigger the alert. Provides context for evaluating the severity of the exceedance. ]]> </comment>
	</column>
	<column name="triggered_at" not-null="true">
		<type name="timestamptz" length="0"/>
		<comment> <![CDATA[Exact time the laert condition was detected. ]]> </comment>
	</column>
	<column name="acknowledged_at">
		<type name="timestamptz" length="100"/>
		<comment> <![CDATA[Time the alert was acknowledged by an operator or engineer. Null if not yet acknowledged. ]]> </comment>
	</column>
	<column name="acknowledged_by">
		<type name="varchar" length="100"/>
		<comment> <![CDATA[Name or user ID of the person who acknowledged the alert. Null if not yet acknowledged. ]]> </comment>
	</column>
	<column name="resolved_at">
		<type name="timestamptz" length="0"/>
		<comment> <![CDATA[Time the alert condition was resolved or cleared. Null if still active. ]]> </comment>
	</column>
	<column name="resolution_notes">
		<type name="text" length="0"/>
		<comment> <![CDATA[Description of the corrective actions taken to resolve the alert condition. Important for trend analysis and recurring issue identification. ]]> </comment>
	</column>
	<column name="is_active" not-null="true" default-value="TRUE">
		<type name="boolean" length="0"/>
		<comment> <![CDATA[Whether this alert is currently active. Set to false when resolved. Supports dashboard filtering for current alarm status. ]]> </comment>
	</column>
	<column name="created_at" not-null="true" default-value="CURRENT_TIMESTAMP">
		<type name="timestamp" length="0"/>
		<comment> <![CDATA[Timestamp of when this alert record was created in the database. ]]> </comment>
	</column>
	<constraint name="alerts_pk" type="pk-constr" table="public.alerts">
		<columns names="alert_id" ref-type="src-columns"/>
	</constraint>
</table>

<relationship name="instruments_has_many_alerts" type="rel1n" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 fk-idx-pattern="{st}_idx"
	 custom-color="#4f253f"
	 src-table="public.instruments"
	 dst-table="public.alerts"
	 src-required="false" dst-required="false"/>

<table name="maintenance_events" layers="0" collapse-mode="2" max-obj-count="18" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="1597.78" y="1020"/>
	<column name="event_id" not-null="true"
	 identity-type="ALWAYS">
		<type name="bigint" length="0"/>
		<comment> <![CDATA[Primary key. Auto-incrementing bigint identifier for each maintenance event. ]]> </comment>
	</column>
	<column name="event_type" not-null="true">
		<type name="varchar" length="30"/>
		<comment> <![CDATA[Type of maintenance activity performed (e.g., CALIBRATION, REPAIR, REPLACEMENT, INSPECTION, PREVENTITIVE, CORRECTIVE, SURVEILLANCE).]]> </comment>
	</column>
	<column name="work_order_number">
		<type name="varchar" length="30"/>
		<comment> <![CDATA[Plant work order number associated with this maintenance activity. Links to the plant's work management system for full documentation. ]]> </comment>
	</column>
	<column name="description" not-null="true">
		<type name="text" length="0"/>
		<comment> <![CDATA[Detailed description of the maintenance activity performed, including scope of work, findings, and any as-left conditions. ]]> </comment>
	</column>
	<column name="performed_by">
		<type name="varchar" length="100"/>
		<comment> <![CDATA[Name or ID of the technician or engineer who performed the maintenance. Important for qualification tracking and accountability. ]]> </comment>
	</column>
	<column name="reviewed_by">
		<type name="varchar" length="100"/>
		<comment> <![CDATA[Name or ID of the person who reviewed and approved the completed maintencance work. Required for safety-related instrument maintenance per 10CFR50 Appendix B. ]]> </comment>
	</column>
	<column name="scheduled_date">
		<type name="date" length="0"/>
		<comment> <![CDATA[Planned date for the maintenance activity. Used for scheduling and workload planning. ]]> </comment>
	</column>
	<column name="started_at">
		<type name="timestamptz" length="0"/>
		<comment> <![CDATA[Actual date and time the maintenance work began. ]]> </comment>
	</column>
	<column name="completed_at">
		<type name="timestamptz" length="0"/>
		<comment> <![CDATA[Date and time the maintenance work was completed. Null if work is still in progress. ]]> </comment>
	</column>
	<column name="findings">
		<type name="text" length="0"/>
		<comment> <![CDATA[Observations and findings during the maintenance activity including any unexpected conditions, degradation, or anomalies discovered. ]]> </comment>
	</column>
	<column name="corrective_actions">
		<type name="text" length="0"/>
		<comment> <![CDATA[Actions taken to correct any issues found during maintenance. Includes parts replaced, adjustments made, and any follow-up actions required. ]]> </comment>
	</column>
	<column name="status" not-null="true" default-value="'SCHEDULED'">
		<type name="varchar" length="20"/>
		<comment> <![CDATA[Current status of the maintenance event (e.g., SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED, DEFERRED).]]> </comment>
	</column>
	<column name="created_at" not-null="true" default-value="CURRENT_TIMESTAMP">
		<type name="timestamp" length="0"/>
		<comment> <![CDATA[Timestamp of when this maintenance event record was created in the database. ]]> </comment>
	</column>
	<column name="updated_at" not-null="true" default-value="CURRENT_TIMESTAMP">
		<type name="timestamp" length="0"/>
		<comment> <![CDATA[Timestamp of the last update to this record. ]]> </comment>
	</column>
	<constraint name="maintenance_events_pk" type="pk-constr" table="public.maintenance_events">
		<columns names="event_id" ref-type="src-columns"/>
	</constraint>
</table>

<relationship name="instruments_has_many_maintenance_events" type="rel1n" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 fk-idx-pattern="{st}_idx"
	 custom-color="#4d0e92"
	 src-table="public.instruments"
	 dst-table="public.maintenance_events"
	 src-required="false" dst-required="false"/>

<table name="calibration_records" layers="0" collapse-mode="2" max-obj-count="24" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="34.2857" y="1265.71"/>
	<column name="calibration_id" not-null="true"
	 identity-type="ALWAYS">
		<type name="bigint" length="0"/>
		<comment> <![CDATA[Primary key. Auto-incrementing bigint identifier for each calibration record. ]]> </comment>
	</column>
	<column name="calibration_type" not-null="true">
		<type name="varchar" length="30"/>
		<comment> <![CDATA[Type of calibration performed (eg., FULL, PARTIAL, CHANNEL_CHECK, FUNCTIONAL, TEST, CROSS_CALIBRATION). Determine the scope and rigor of the calibration data. ]]> </comment>
	</column>
	<column name="calibration_date" not-null="true">
		<type name="date" length="0"/>
		<comment> <![CDATA[Date the calibration was performed. Used to update the instrument's last_calibration_date and calculate the next due date. ]]> </comment>
	</column>
	<column name="calibration_due_date">
		<type name="date" length="0"/>
		<comment> <![CDATA[Date by which this calibration was required. Comparing with calibration_date shows whether calibration was performed on time, early, or late. ]]> </comment>
	</column>
	<column name="as_found_in_tolerance" not-null="true">
		<type name="boolean" length="0"/>
		<comment> <![CDATA[Whether the instrument was found within its required tolerance before any adjustments. A critical metric for drift analysis and instrument reliability assessment. ]]> </comment>
	</column>
	<column name="as_left_in_tolerance" not-null="true">
		<type name="boolean" length="0"/>
		<comment> <![CDATA[Whether the instrument was within required tolerance after calibration adjustments. Must be true for the instrument to be returned to service. ]]> </comment>
	</column>
	<column name="as_found_data">
		<type name="text" length="0"/>
		<comment> <![CDATA[Detailed as-found calibration data including test point values, measured outputs, and deviations from expected values. May be stored as structured text or JSON. ]]> </comment>
	</column>
	<column name="as_left_data">
		<type name="text" length="0"/>
		<comment> <![CDATA[Detailed as-left calibration data after adjustments. Same format as  as_found_data. Comparison between as-found and as-left quantifies the drift that occurred. ]]> </comment>
	</column>
	<column name="drift_value">
		<type name="numeric" length="0"/>
		<comment> <![CDATA[Calculated drift since the previous calibration, typically expressed as the maximum deviation across all test points. The primary input for SPRT-based drift monitoring. ]]> </comment>
	</column>
	<column name="drift_unit">
		<type name="varchar" length="20"/>
		<comment> <![CDATA[Engineering unit or format of the drift value (e.g., °C, % of span). Must be consistent across calibration records for the same instrument to enable trend analysis. ]]> </comment>
	</column>
	<column name="tolerance_band">
		<type name="numeric" length="0"/>
		<comment> <![CDATA[The allowable tolerance band used to evaluate as-found and as-left conditions. Typically expressed in the same units as drift_value or as percent of span. ]]> </comment>
	</column>
	<column name="reference_standard">
		<type name="varchar" length="100"/>
		<comment> <![CDATA[Identification of the reference standard or test equipment used for calibration. Must be traceable to NIST or equivalent national standards per 10CFR50 Appendix B. ]]> </comment>
	</column>
	<column name="reference_standard_due_date">
		<type name="date" length="0"/>
		<comment> <![CDATA[Calibration due date of the reference standard at time of use. Verifies the standard was in calibration when used, a key QA requirement. ]]> </comment>
	</column>
	<column name="performed_by">
		<type name="varchar" length="100"/>
		<comment> <![CDATA[Name or ID of the technician who performed the calibration. Required for qualification verification and accountability. ]]> </comment>
	</column>
	<column name="reviewed_by">
		<type name="varchar" length="100"/>
		<comment> <![CDATA[Name or ID of the person who reviewed and approved the calibration results. Required for safety-related calibrations per 10CFR50 Appendix B. ]]> </comment>
	</column>
	<column name="work_order_number">
		<type name="varchar" length="30"/>
		<comment> <![CDATA[Plant work order number associated with this calibration. Links to the plant's work management system and the corresponding maintenance_events record. ]]> </comment>
	</column>
	<column name="procedure_number">
		<type name="varchar" length="30"/>
		<comment> <![CDATA[Calibration procedure number used to perform the calibration. Required for repeatability and regulatory  compliance. ]]> </comment>
	</column>
	<column name="notes">
		<type name="text" length="0"/>
		<comment> <![CDATA[Additional observations, anomalies, or conditions noted during calibration. Includes any limitations, compensatory measures, or receommended follow-up actions. ]]> </comment>
	</column>
	<column name="created_at" not-null="true" default-value="CURRENT_TIMESTAMP">
		<type name="timestamp" length="0"/>
		<comment> <![CDATA[Timestamp of when this calibration record was created in the database. ]]> </comment>
	</column>
	<constraint name="calibration_records_pk" type="pk-constr" table="public.calibration_records">
		<columns names="calibration_id" ref-type="src-columns"/>
	</constraint>
</table>

<relationship name="instruments_has_many_calibration_records" type="rel1n" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 fk-idx-pattern="{st}_idx"
	 custom-color="#cb2a85"
	 src-table="public.instruments"
	 dst-table="public.calibration_records"
	 src-required="false" dst-required="false"/>

