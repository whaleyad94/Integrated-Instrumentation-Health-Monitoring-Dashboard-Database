<table name="technicians" layers="0" collapse-mode="2" max-obj-count="15" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="694.286" y="1600"/>
	<column name="technician_id" not-null="true"
	 identity-type="ALWAYS">
		<type name="integer" length="0"/>
		<comment> <![CDATA[Primary key. Auto-incrementing integer identifier for each technician.]]> </comment>
	</column>
	<column name="employee_id" not-null="true">
		<type name="varchar" length="20"/>
		<comment> <![CDATA[Plant-assigned employee identifier. The unique business key used in work orders, qualification records, and access control systems.]]> </comment>
	</column>
	<column name="first_name" not-null="true">
		<type name="varchar" length="50"/>
		<comment> <![CDATA[Technician's first name.]]> </comment>
	</column>
	<column name="last_name" not-null="true">
		<type name="varchar" length="50"/>
		<comment> <![CDATA[Technician's last name.]]> </comment>
	</column>
	<column name="job_title">
		<type name="varchar" length="50"/>
		<comment> <![CDATA[Current job title or role (e.g., I&C Technician, Senior I&C Technician, I&C Engineer, Reactor Engineer).]]> </comment>
	</column>
	<column name="department">
		<type name="varchar" length="50"/>
		<comment> <![CDATA[Department the technician belongs to (e.g., Instrumentation & Controls, Reactor Engineering, Maintenance).]]> </comment>
	</column>
	<column name="qualification_level">
		<type name="varchar" length="30"/>
		<comment> <![CDATA[Overall qualification level (e.g., APPRENTICE, QUALIFIED, SENIOR, SUPERVISOR, SPECIALIST). Determines which maintenance and calibration tasks the technician may perform.]]> </comment>
	</column>
	<column name="certification_expiry_date">
		<type name="date" length="0"/>
		<comment> <![CDATA[Date when the technician's current certification expires. Instruments calibrated by technicians with expired certifications may require recalibration per QA requirements.]]> </comment>
	</column>
	<column name="is_active" not-null="true" default-value="TRUE">
		<type name="boolean" length="0"/>
		<comment> <![CDATA[Whether the technician is currently active. Inactive technicians are retained for historical traceability of past maintenance and calibration records.]]> </comment>
	</column>
	<column name="email">
		<type name="varchar" length="100"/>
		<comment> <![CDATA[Technician's email address. Used for notification routing when alerts require response from qualified personnel.]]> </comment>
	</column>
	<column name="phone">
		<type name="varchar" length="20"/>
		<comment> <![CDATA[Technician's contact phone number.]]> </comment>
	</column>
	<column name="created_at" not-null="true" default-value="CURRENT_TIMESTAMP">
		<type name="timestamp" length="0"/>
		<comment> <![CDATA[Timestamp of when this technician record was created in the database.]]> </comment>
	</column>
	<column name="updated_at" not-null="true" default-value="CURRENT_TIMESTAMP">
		<type name="timestamp" length="0"/>
		<comment> <![CDATA[Timestamp of the last update to this record.]]> </comment>
	</column>
	<constraint name="technicians_pk" type="pk-constr" table="public.technicians">
		<columns names="technician_id" ref-type="src-columns"/>
	</constraint>
	<constraint name="uq_technicians_employee_id" type="uq-constr" table="public.technicians">
		<columns names="employee_id" ref-type="src-columns"/>
	</constraint>
</table>

