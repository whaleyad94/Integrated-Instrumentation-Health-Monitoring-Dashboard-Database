<table name="notifications" layers="0" collapse-mode="2" max-obj-count="13" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="1900" y="-400"/>
	<column name="notification_id" not-null="true"
	 identity-type="ALWAYS">
		<type name="bigint" length="0"/>
		<comment> <![CDATA[Primary key. Auto-incrementing bigint identifier for each notification.]]> </comment>
	</column>
	<column name="notification_channel" not-null="true">
		<type name="varchar" length="20"/>
		<comment> <![CDATA[Delivery method for the notification (e.g., EMAIL, DASHBOARD, SMS, PAGER). Determines how the notification is routed to the recipient.]]> </comment>
	</column>
	<column name="subject" not-null="true">
		<type name="varchar" length="200"/>
		<comment> <![CDATA[Subject line or title of the notification. Provides a concise summary for quick triage.]]> </comment>
	</column>
	<column name="message" not-null="true">
		<type name="text" length="0"/>
		<comment> <![CDATA[Full notification message body including alert details, instrument identification, recommended actions, and any relevant context.]]> </comment>
	</column>
	<column name="sent_at" not-null="true" default-value="CURRENT_TIMESTAMP">
		<type name="timestamptz" length="0"/>
		<comment> <![CDATA[Timestamp when the notification was sent or queued for delivery.]]> </comment>
	</column>
	<column name="read_at">
		<type name="timestamptz" length="0"/>
		<comment> <![CDATA[Timestamp when the recipient read or opened the notification. Null if not yet read. Supports response time tracking.]]> </comment>
	</column>
	<column name="is_read" not-null="true" default-value="FALSE">
		<type name="boolean" length="0"/>
		<comment> <![CDATA[Whether the notification has been read by the recipient. Supports dashboard filtering for unread notifications.]]> </comment>
	</column>
	<column name="delivery_status" not-null="true" default-value="'PENDING'">
		<type name="varchar" length="20"/>
		<comment> <![CDATA[Current delivery status of the notification (e.g., PENDING, SENT, DELIVERED, FAILED, BOUNCED). Supports retry logic and delivery confirmation.]]> </comment>
	</column>
	<column name="created_at" not-null="true" default-value="CURRENT_TIMESTAMP">
		<type name="timestamp" length="0"/>
		<comment> <![CDATA[Timestamp of when this notification record was created in the database.]]> </comment>
	</column>
	<constraint name="notifications_pk" type="pk-constr" table="public.notifications">
		<columns names="notification_id" ref-type="src-columns"/>
	</constraint>
</table>

