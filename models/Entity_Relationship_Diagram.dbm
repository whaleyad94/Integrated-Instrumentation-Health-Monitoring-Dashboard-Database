	<column name="location_code" not-null="true">
		<type name="varchar" length="20"/>
		<comment> <![CDATA[Short location identifier code (e.g., CTMT for containment, AUX-2 for auxiliary building second floor). Used in plant documentation and work orders.]]> </comment>
	</column>
	<column name="location_name" not-null="true">
		<type name="varchar" length="100"/>
		<comment> <![CDATA[Full descriptive name of the location (e.g., Containment Building, Auxiliary Building Second Floor)]]> </comment>
	</column>
	<column name="location_type" not-null="true">
		<type name="varchar" length="20"/>
		<comment> <![CDATA[Level in the location hierarchy (e.g., Building, Floor, Room, Area, Equipment). Supports hierarchical filtering and navigation.]]> </comment>
	</column>
	<column name="parent_location_id">
		<type name="integer" length="0"/>
